{
  "hosting": {
    "public": ".",
    "ignore": [
      "!(index.html|css|js|assets)",
      "!(index.html|css|js|assets)/**",
      "**/.*",
      "**/node_modules/**",
      "**/*.log"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
